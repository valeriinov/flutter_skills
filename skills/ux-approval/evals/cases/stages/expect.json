{
  "steps": [
    [
      "{skills}/ux-approval/evals/git_fixture.py",
      "{tmp}/repo"
    ],
    {
      "copy": "{cases}/spec-r1/spec.json",
      "to": "{tmp}/r1/spec.json",
      "set": []
    },
    [
      "{approval}",
      "stages",
      "{tmp}/r1/spec.json",
      "--project",
      "{tmp}/repo",
      "--prod-tag",
      "v*_PROD",
      "--test-tag",
      "v*_FOR_TEST"
    ],
    [
      "{approval}",
      "check",
      "{tmp}/r1/spec.json"
    ],
    [
      "{approval}",
      "build",
      "{tmp}/r1/spec.json",
      "--template",
      "{template}"
    ],
    {
      "read": "{tmp}/r1/page.html"
    },
    {
      "copy": "{cases}/spec-r1/spec.json",
      "to": "{tmp}/old/spec.json",
      "set": []
    },
    [
      "{approval}",
      "stages",
      "{tmp}/old/spec.json",
      "--project",
      "{tmp}/repo",
      "--prod-tag",
      "v*_PROD",
      "--test-tag",
      "v0.*"
    ],
    [
      "{approval}",
      "build",
      "{tmp}/old/spec.json",
      "--template",
      "{template}"
    ],
    {
      "read": "{tmp}/old/page.html"
    },
    {
      "copy": "{cases}/spec-r1/spec.json",
      "to": "{tmp}/late/spec.json",
      "set": []
    },
    [
      "{approval}",
      "stages",
      "{tmp}/late/spec.json",
      "--project",
      "{tmp}/repo",
      "--prod-tag",
      "v*_PROD",
      "--test-tag",
      "v0.1*"
    ],
    {
      "copy": "{cases}/spec-r1/spec.json",
      "to": "{tmp}/bad/spec.json",
      "set": [
        [
          [
            "stages"
          ],
          {
            "uk.homeTitle": {
              "stage": "beta",
              "inTest": true
            },
            "uk.noSuchKey": {
              "stage": "dev",
              "inTest": false
            }
          }
        ],
        [
          [
            "releases"
          ],
          {
            "prod": {
              "tag": "v1"
            },
            "test": null
          }
        ]
      ]
    },
    [
      "{approval}",
      "check",
      "{tmp}/bad/spec.json"
    ]
  ],
  "exit": 1,
  "fragments": [
    "\"releases\":{\"prod\":{\"tag\":\"v1.0.0b1_PROD\",\"version\":\"1.0.0+1\"},\"test\":{\"tag\":\"v1.0.1b2_FOR_TEST\",\"version\":\"1.0.1+2\"}}",
    "\"key\":\"homeTitle\"",
    "\"stage\":{\"uk\":{\"stage\":\"test\",\"inTest\":true,\"prodText\":\"Рослини\"},\"en\":{\"stage\":\"test\",\"inTest\":true}}",
    "\"stage\":{\"uk\":{\"stage\":\"prod\",\"inTest\":false},\"en\":{\"stage\":\"test\",\"inTest\":true}}",
    "\"stage\":{\"uk\":{\"stage\":\"dev\",\"inTest\":false,\"prodText\":\"Полий\"},\"en\":{\"stage\":\"dev\",\"inTest\":false}}",
    "\"stage\":{\"uk\":{\"stage\":\"prod\",\"inTest\":true},\"en\":{\"stage\":\"test\",\"inTest\":true}}",
    "test tag v0.9.0b9_FOR_TEST dropped: its commit is not newer than prod v1.0.0b1_PROD",
    "\"releases\":{\"prod\":{\"tag\":\"v1.0.0b1_PROD\",\"version\":\"1.0.0+1\"},\"test\":null}",
    "\"stage\":{\"uk\":{\"stage\":\"prod\",\"inTest\":false},\"en\":{\"stage\":\"dev\",\"inTest\":false}}",
    "spec:stages.uk.homeTitle: stage must be one of ('prod', 'test', 'dev')",
    "spec:stages.uk.noSuchKey: key not in uk values",
    "spec:releases.prod: must be null or {tag, version}",
    "releases: prod v1.0.0b1_PROD 1.0.0+1, test v0.1.0b99_FOR_TEST 0.1.0+99"
  ],
  "absent": []
}
