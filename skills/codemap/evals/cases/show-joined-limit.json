{
  "steps": [
    {
      "run": [
        "show",
        "applyConfig",
        "--root",
        "$ROOT"
      ],
      "max_length": 2500,
      "expect": [
        "method FirstConfig.applyConfig  lib/configs.dart:2",
        "method SecondConfig.applyConfig  lib/configs.dart:24",
        "method ThirdConfig.applyConfig  lib/configs.dart:46",
        "lib/config_calls.dart:4 in applyDefaults"
      ]
    },
    {
      "hook": {
        "hook_event_name": "PreToolUse",
        "session_id": "session-d",
        "cwd": "$ROOT",
        "tool_name": "Bash",
        "tool_input": {
          "command": "rg -n 'applyConfig|resetConfig' lib"
        }
      },
      "max_length": 5011,
      "expect": [
        "`applyConfig`, `resetConfig`",
        "method FirstConfig.resetConfig"
      ]
    }
  ]
}